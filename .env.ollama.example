# Native Ollama profile. No LLM API key is required.
TRADINGAGENTS_QUICK_LLM_PROVIDER=ollama
TRADINGAGENTS_QUICK_THINK_LLM=qwen3:8b
TRADINGAGENTS_QUICK_LLM_BASE_URL=http://127.0.0.1:11434/v1
TRADINGAGENTS_DEEP_LLM_PROVIDER=ollama
TRADINGAGENTS_DEEP_THINK_LLM=qwen3:8b
TRADINGAGENTS_DEEP_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Provider fallback used when a role URL is omitted.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
TRADINGAGENTS_OUTPUT_LANGUAGE=Vietnamese
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=true

GX_DATA_TRANSPORT=api
GX_MARKET_INFO_BASE_URL=http://127.0.0.1:5005
GX_MARKET_INFO_API_VERSION=v1.0.7
GX_MARKET_INFO_TV_TOKEN=
GX_ANALYSIS_DATA_API_KEY=
GX_DATA_TIMEOUT_SECONDS=10
GX_MARKET_INFO_EXPECTED_DB=g_market_info_1229

# For containerized TradingAgents talking to native Ollama on the host, use the
# following. For FireAnt content, host.docker.internal is non-loopback and is
# conservatively treated as hosted; enable the hosted-LLM flag only if approved.
#TRADINGAGENTS_QUICK_LLM_BASE_URL=http://host.docker.internal:11434/v1
#TRADINGAGENTS_DEEP_LLM_BASE_URL=http://host.docker.internal:11434/v1

# Vietnam retail social (FireAnt; requires optional extra `.[fireant]`). FireAnt
# itself still needs Internet. Keep locked until APG has written permission for
# automated collection, encrypted retention and derived sentiment.
TRADINGAGENTS_VN_SOCIAL_PROVIDER=fireant
TRADINGAGENTS_FIREANT_AUTHORIZED=false
TRADINGAGENTS_FIREANT_HOSTED_LLM_AUTHORIZED=false
FIREANT_ACCESS_TOKEN=
FIREANT_ARCHIVE_ENCRYPTION_KEY=
TRADINGAGENTS_VN_SOCIAL_TICKERS=HPG,FPT,VCB
TRADINGAGENTS_VN_SOCIAL_LOOKBACK_DAYS=7
TRADINGAGENTS_VN_SOCIAL_MIN_POSTS=10
TRADINGAGENTS_VN_SOCIAL_MIN_UNIQUE_AUTHORS=5
TRADINGAGENTS_VN_SOCIAL_POLL_SECONDS=300
TRADINGAGENTS_SOCIAL_RAW_RETENTION_DAYS=90
# Archive schema v2; keep the file and its backups under the same retention.
#TRADINGAGENTS_SOCIAL_ARCHIVE_PATH=/absolute/path/to/vn_social.sqlite3

# Vietnam editorial media (CafeF/VnExpress RSS; requires `.[vn-media]`). A
# loopback Ollama is local; collection still requires source authorization.
TRADINGAGENTS_VN_MEDIA_PROVIDERS=cafef_rss,vnexpress_rss
TRADINGAGENTS_CAFEF_RSS_AUTHORIZED=false
TRADINGAGENTS_CAFEF_HOSTED_LLM_AUTHORIZED=false
TRADINGAGENTS_VNEXPRESS_RSS_AUTHORIZED=false
TRADINGAGENTS_VNEXPRESS_HOSTED_LLM_AUTHORIZED=false
VN_MEDIA_ARCHIVE_ENCRYPTION_KEY=
TRADINGAGENTS_VN_MEDIA_TICKERS=HPG,FPT,VCB
TRADINGAGENTS_VN_MEDIA_LOOKBACK_DAYS=7
TRADINGAGENTS_VN_MEDIA_MIN_ARTICLES=3
TRADINGAGENTS_VN_MEDIA_POLL_SECONDS=300
TRADINGAGENTS_VN_MEDIA_RAW_RETENTION_DAYS=30
#TRADINGAGENTS_VN_MEDIA_ARCHIVE_PATH=/absolute/path/to/vn_media.sqlite3

# Official NSO/SBV macro archive. Ollama stays local, but collection requires
# Internet access to the allowlisted official endpoints.
TRADINGAGENTS_VN_MACRO_ENABLED=true
TRADINGAGENTS_VN_MACRO_PROVIDERS=nso_sdmx,nso_release,sbv_html
TRADINGAGENTS_VN_MACRO_LOOKBACK_MONTHS=24
TRADINGAGENTS_VN_MACRO_STRICT_PIT=true
TRADINGAGENTS_VN_MACRO_TIMEOUT_SECONDS=15
#TRADINGAGENTS_VN_MACRO_ARCHIVE_PATH=/absolute/path/to/vn_macro.sqlite3
